<!DOCTYPE html>
<html lang="es">
<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <!--
    Este archivo es un componente.
    No queremos que Google lo indexe como página independiente.
  -->
  <meta
    name="robots"
    content="noindex, nofollow"
  >

  <title>
    WhatsApp | Digitalmente Pro
  </title>


  <style>

    /* =====================================================
       DIGITALMENTE PRO
       BOTÓN FLOTANTE WHATSAPP
       ===================================================== */

    :root {

      --orange: #ff6a13;

      --whatsapp: #25D366;
      --whatsapp-dark: #1ebe5d;

      --white: #ffffff;

      --text: #141414;
      --text-soft: #777777;

      --border: #ece5df;

    }


    * {
      box-sizing: border-box;
    }


    body {

      margin: 0;

      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Arial,
        sans-serif;

      background:
        #fffaf6;

    }


    /* =====================================================
       CONTENEDOR
       ===================================================== */

    .whatsapp-floating {

      position:
        fixed;

      right:
        28px;

      bottom:
        28px;

      z-index:
        9999;

      display:
        flex;

      flex-direction:
        column;

      align-items:
        flex-end;

      gap:
        11px;

    }


    /* =====================================================
       BURBUJA
       ===================================================== */

    .whatsapp-message {

      position:
        relative;

      width:
        max-content;

      max-width:
        290px;

      padding:
        14px 17px;

      background:
        rgba(255,255,255,.96);

      backdrop-filter:
        blur(15px);

      -webkit-backdrop-filter:
        blur(15px);

      border:
        1px solid
        var(--border);

      border-radius:
        18px 18px 5px 18px;

      box-shadow:
        0 18px 45px
        rgba(40,20,10,.12);

      animation:
        whatsappMessageIn
        .55s ease;

    }


    .whatsapp-message::after {

      content: "";

      position:
        absolute;

      right:
        13px;

      bottom:
        -8px;

      width:
        15px;

      height:
        15px;

      background:
        #ffffff;

      border-right:
        1px solid
        var(--border);

      border-bottom:
        1px solid
        var(--border);

      transform:
        rotate(45deg);

    }


    .whatsapp-message__brand {

      display:
        flex;

      align-items:
        center;

      gap:
        7px;

      margin-bottom:
        5px;

      color:
        var(--orange);

      font-size:
        11px;

      font-weight:
        900;

      letter-spacing:
        .8px;

      text-transform:
        uppercase;

    }


    .whatsapp-message__brand::before {

      content: "";

      display:
        block;

      width:
        7px;

      height:
        7px;

      border-radius:
        50%;

      background:
        var(--orange);

    }


    .whatsapp-message strong {

      display:
        block;

      color:
        var(--text);

      font-size:
        14px;

      line-height:
        1.35;

    }


    .whatsapp-message p {

      margin:
        5px 0 0;

      color:
        var(--text-soft);

      font-size:
        12px;

      line-height:
        1.45;

    }


    /* =====================================================
       BOTÓN WHATSAPP
       ===================================================== */

    .whatsapp-button {

      width:
        64px;

      height:
        64px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        50%;

      background:
        var(--whatsapp);

      color:
        #ffffff;

      text-decoration:
        none;

      box-shadow:

        0 12px 30px
        rgba(37,211,102,.38),

        0 0 0 0
        rgba(37,211,102,.20);

      transition:
        transform .22s ease,
        background .22s ease,
        box-shadow .22s ease;

      animation:
        whatsappPulse
        2.8s
        infinite;

    }


    .whatsapp-button:hover {

      transform:
        scale(1.08);

      background:
        var(--whatsapp-dark);

      box-shadow:
        0 16px 36px
        rgba(37,211,102,.48);

      animation:
        none;

    }


    .whatsapp-button:focus-visible {

      outline:
        3px solid
        rgba(37,211,102,.30);

      outline-offset:
        5px;

    }


    .whatsapp-button svg {

      width:
        35px;

      height:
        35px;

      display:
        block;

      fill:
        #ffffff;

    }


    /* =====================================================
       TEXTO INFERIOR
       ===================================================== */

    .whatsapp-label {

      margin-right:
        6px;

      color:
        #777777;

      font-size:
        10px;

      font-weight:
        600;

    }


    /* =====================================================
       CERRAR BURBUJA
       ===================================================== */

    .whatsapp-close {

      position:
        absolute;

      top:
        7px;

      right:
        8px;

      width:
        22px;

      height:
        22px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border:
        0;

      border-radius:
        50%;

      background:
        transparent;

      color:
        #aaaaaa;

      font-size:
        16px;

      line-height:
        1;

      cursor:
        pointer;

    }


    .whatsapp-close:hover {

      background:
        #f4f4f4;

      color:
        #555555;

    }


    /* =====================================================
       ANIMACIONES
       ===================================================== */

    @keyframes whatsappMessageIn {

      from {

        opacity:
          0;

        transform:
          translateY(12px)
          scale(.97);

      }


      to {

        opacity:
          1;

        transform:
          translateY(0)
          scale(1);

      }

    }


    @keyframes whatsappPulse {

      0%,
      100% {

        box-shadow:

          0 12px 30px
          rgba(37,211,102,.38),

          0 0 0 0
          rgba(37,211,102,.17);

      }


      50% {

        box-shadow:

          0 14px 34px
          rgba(37,211,102,.48),

          0 0 0 12px
          rgba(37,211,102,0);

      }

    }


    /* =====================================================
       MOBILE
       ===================================================== */

    @media
    (max-width: 600px) {


      .whatsapp-floating {

        right:
          16px;

        bottom:
          18px;

      }


      .whatsapp-button {

        width:
          58px;

        height:
          58px;

      }


      .whatsapp-button svg {

        width:
          32px;

        height:
          32px;

      }


      .whatsapp-message {

        max-width:
          calc(100vw - 48px);

        padding:
          13px 40px 13px 15px;

      }


      .whatsapp-label {

        display:
          none;

      }

    }


    /* =====================================================
       ACCESIBILIDAD
       ===================================================== */

    @media
    (prefers-reduced-motion: reduce) {


      .whatsapp-button,
      .whatsapp-message {

        animation:
          none;

      }

    }

  </style>

</head>


<body>


  <!-- =====================================================
       BOTÓN FLOTANTE WHATSAPP
       ===================================================== -->

  <div
    class="whatsapp-floating"
    id="whatsappFloating"
  >


    <!-- MENSAJE -->

    <div
      class="whatsapp-message"
      id="whatsappMessage"
    >


      <button
        type="button"
        class="whatsapp-close"
        id="whatsappClose"
        aria-label="Cerrar mensaje de WhatsApp"
      >
        ×
      </button>


      <div class="whatsapp-message__brand">

        Digitalmente Pro

      </div>


      <strong>

        Hola 👋 ¿En qué podemos ayudarte?

      </strong>


      <p>

        Escríbenos directamente por WhatsApp.

      </p>


    </div>


    <!-- TEXTO PEQUEÑO -->

    <div class="whatsapp-label">

      Resolvamos tus dudas

    </div>


    <!-- BOTÓN -->

    <a
      class="whatsapp-button"
      href="https://wa.me/56987689361?text=Hola%20%F0%9F%91%8B%20Vi%20la%20p%C3%A1gina%20de%20Digitalmente%20Pro%20y%20me%20gustar%C3%ADa%20obtener%20m%C3%A1s%20informaci%C3%B3n%20sobre%20sus%20servicios."
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contactar a Digitalmente Pro por WhatsApp"
      title="Hablar por WhatsApp"
    >


      <!--
        Ícono integrado.
        No depende de ninguna imagen externa.
      -->

      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
      >

        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
        />

      </svg>


    </a>


  </div>


  <!-- =====================================================
       JAVASCRIPT
       ===================================================== -->

  <script>

    const whatsappMessage =
      document.getElementById(
        "whatsappMessage"
      );


    const whatsappClose =
      document.getElementById(
        "whatsappClose"
      );


    whatsappClose.addEventListener(
      "click",
      function () {

        whatsappMessage.style.display =
          "none";

      }
    );

  </script>


</body>
</html>
