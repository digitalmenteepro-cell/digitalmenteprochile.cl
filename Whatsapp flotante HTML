<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Botón WhatsApp Flotante</title>
  <style>
    /* ===== BOTÓN FLOTANTE WSP ===== */
    .wsp-flotante {
      position: fixed;
      bottom: 30px;
      right: 30px;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 10px;
    }

    /* Burbuja de mensaje */
    .wsp-burbuja {
      background: #ffffff;
      color: #111;
      padding: 12px 18px;
      border-radius: 18px 18px 0 18px;
      font-family: 'Segoe UI', Arial, sans-serif;
      font-size: 14px;
      font-weight: 500;
      box-shadow: 0 4px 20px rgba(0,0,0,0.15);
      white-space: nowrap;
      animation: fadeInUp 0.4s ease;
      position: relative;
      border: 1px solid #e8e8e8;
    }

    .wsp-burbuja::before {
      content: '';
      position: absolute;
      bottom: -1px;
      right: -10px;
      width: 0;
      height: 0;
      border-left: 10px solid #ffffff;
      border-bottom: 10px solid transparent;
    }

    .wsp-burbuja::after {
      content: '';
      position: absolute;
      bottom: -2px;
      right: -12px;
      width: 0;
      height: 0;
      border-left: 11px solid #e8e8e8;
      border-bottom: 11px solid transparent;
      z-index: -1;
    }

    .wsp-burbuja .wsp-saludo {
      color: #888;
      font-size: 11px;
      font-weight: 400;
      display: block;
      margin-bottom: 2px;
    }

    /* Botón circular */
    .wsp-btn {
      width: 62px;
      height: 62px;
      border-radius: 50%;
      background: #25D366;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 6px 24px rgba(37, 211, 102, 0.45);
      cursor: pointer;
      text-decoration: none;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      animation: pulse 2.5s infinite;
    }

    .wsp-btn:hover {
      transform: scale(1.1);
      box-shadow: 0 8px 30px rgba(37, 211, 102, 0.6);
      animation: none;
    }

    .wsp-btn img {
      width: 40px;
      height: 40px;
      object-fit: contain;
    }

    /* Punto verde activo */
    .wsp-activo {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Segoe UI', Arial, sans-serif;
      font-size: 11px;
      color: #888;
      justify-content: flex-end;
    }

    .wsp-activo-dot {
      width: 8px;
      height: 8px;
      background: #25D366;
      border-radius: 50%;
      animation: blink 1.5s infinite;
    }

    /* Animaciones */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes pulse {
      0%, 100% { box-shadow: 0 6px 24px rgba(37, 211, 102, 0.45); }
      50%       { box-shadow: 0 6px 30px rgba(37, 211, 102, 0.75), 0 0 0 10px rgba(37,211,102,0.1); }
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.3; }
    }

    /* Mobile */
    @media (max-width: 480px) {
      .wsp-flotante {
        bottom: 20px;
        right: 16px;
      }
      .wsp-burbuja {
        font-size: 13px;
        padding: 10px 14px;
      }
    }
  </style>
</head>
<body style="background:#f5f5f5; height:100vh; margin:0; display:flex; align-items:center; justify-content:center;">

  <!-- Demo visual -->
  <p style="font-family:sans-serif; color:#aaa; font-size:14px;">← Mira el botón flotante abajo a la derecha</p>

  <!-- ===== BOTÓN WSP FLOTANTE ===== -->
  <div class="wsp-flotante">

    <!-- Burbuja de mensaje -->
    <div class="wsp-burbuja">
      <span class="wsp-saludo">DigitalmentePro Chile</span>
      Hola 👋 ¿En qué te ayudamos hoy?
    </div>

    <!-- Indicador en línea -->
    <div class="wsp-activo">
      <span class="wsp-activo-dot"></span>
      En línea
    </div>

    <!-- Botón circular -->
    <a
      class="wsp-btn"
